    {
      "parameters": {
        "jsCode": "// Strip internal and commercially confidential fields before this leaves n8n.\n// The response is publicly fetchable, so filtering must happen here rather than\n// in the browser, which only decides what to *render*.\nconst CONFIDENTIAL = new Set([\n  'proposed salary',\n  'existing salary band',\n  'hr head decision',\n  'director decision',\n  'hr head rejection reason',\n  'director rejection reason',\n  'approving director',\n  'approving hr head',\n  'hr responsible',\n  'requesting manager',\n  'interview panel',\n  'internal jd file',\n  'v1 record',\n  'job advert email',\n  'job advert whatsapp',\n  'date approved',\n  'time to fill days',\n  'positions filled',\n  'cost centre',\n  'position requirements',\n  'previous failures successes',\n]);\n\nconst norm = (s) => (s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n\n// One item per page fetched, so fold them all \u2014 reading only the first item\n// truncated the board at ClickUp's 100-task page size.\nconst sourceTasks = $input\n  .all()\n  .flatMap((item) => (Array.isArray(item.json.tasks) ? item.json.tasks : []));\n\n// custom_fields are kept whole (including type_config) because the careers page\n// resolves dropdown values and label ids against their options client-side.\nconst tasks = sourceTasks.map((task) => ({\n  id: task.id,\n  name: task.name,\n  status: task.status?.status,\n  description: task.description,\n  text_content: task.text_content,\n  date_created: task.date_created,\n  date_updated: task.date_updated,\n  custom_fields: (task.custom_fields || []).filter(\n    (field) => !CONFIDENTIAL.has(norm(field.name)),\n  ),\n}));\n\nreturn [{ json: { tasks } }];"
      },
      "id": "b1a1f5d2-0000-4000-8000-000000000003",
      "name": "Strip Confidential Fields",
