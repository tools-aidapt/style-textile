# Copy to .env and fill in. NOTE: every VITE_* value is inlined into the built
# JavaScript and is therefore PUBLIC to anyone who loads the site. No ClickUp
# credential belongs in this file — n8n holds it server-side.

# n8n webhook (GET) that returns the open positions. It should read ClickUp list
# 901220480011 ("Positions", workspace 9012912728) filtered to status "live" and
# return the tasks with their custom_fields intact — either the ClickUp response
# verbatim ({ "tasks": [...] }) or a bare array of task objects. The workflow that
# serves it lives in n8n/careers-positions.workflow.json.
# Production: https://aidapt.app.n8n.cloud/webhook/careers-positions
VITE_JOBS_WEBHOOK_URL=
# Basic auth for the above. These are public in the bundle, so they deter casual
# scraping only and are not a security boundary — keep the endpoint read-only.
# The n8n Webhook node must have Basic Auth enabled for them to mean anything.
VITE_JOBS_WEBHOOK_USER=
VITE_JOBS_WEBHOOK_PASSWORD=

# The public origin this site is served from. Used for canonical URLs and for
# the JobPosting structured data on each role. Defaults to https://aidapt.co.
VITE_SITE_URL=

# n8n webhook (POST, multipart/form-data) that receives application submissions.
# It MUST re-check on the server what the browser can only suggest: that the
# openPosition id is a currently live role, that resumeFile and photo are the
# declared types and under 5MB, and that the request is rate limited per IP.
# See n8n/README.md.
VITE_APPLICATION_WEBHOOK_URL=
VITE_APPLICATION_WEBHOOK_USER=
VITE_APPLICATION_WEBHOOK_PASSWORD=

# ---------------------------------------------------------------------------
# New job requisition (internal, /requisitions/new)
# ---------------------------------------------------------------------------

# n8n webhook (GET) that serves the form schema: every option list keyed by the
# stable field keys in src/requisition/schema.ts, plus the ClickUp member
# directory. n8n reads GET /api/v2/list/901220480011/field, caches it, and maps
# each ClickUp field onto a key. No ClickUp field id, list id or token reaches
# the browser. A key the workspace cannot supply must be reported in
# "missingKeys" — the form then refuses to open rather than silently dropping
# whatever the manager typed into it.
# For local work without n8n, point this at the checked-in fixture:
#   VITE_REQUISITION_SCHEMA_URL=/requisition-schema.sample.json
VITE_REQUISITION_SCHEMA_URL=

# n8n webhook (POST, application/json) that receives a completed requisition.
# It resolves labels to option UUIDs, creates the task in the Positions list
# with status Draft and tag "requisition", stamps Requisition Raised, and
# returns { taskId, taskUrl }. It must reject a repeated submissionId — a
# manager double-clicking Submit must not raise two requisitions.
# Production: https://aidapt.app.n8n.cloud/webhook/job-requisition-form-submission
VITE_REQUISITION_WEBHOOK_URL=

# Optional basic auth, shared by both requisition endpoints. Public in the
# bundle, so this deters casual traffic only.
VITE_REQUISITION_WEBHOOK_USER=
VITE_REQUISITION_WEBHOOK_PASSWORD=

# The requesting-manager picker. Returns the employee register with avatars.
# Production: https://aidapt.app.n8n.cloud/webhook/kenafric/employees-with-avatars
VITE_EMPLOYEES_WEBHOOK_URL=

# "Reports to" and the interview panel picker. Returns the user list.
# Production: https://aidapt.app.n8n.cloud/webhook/kenafric/users
VITE_USERS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Fill the requisition form with sample content in one click, for reviewing
# the form with real text in it. Always on in development; set this only on a
# preview deployment.
#
# Leave it UNSET in production. The sample content is invented, and a
# requisition raised from it would arrive in ClickUp looking like a real one.
VITE_ALLOW_PREFILL=
